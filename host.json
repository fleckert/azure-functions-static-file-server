{
  "version": "2.0",
  "customHandler": {
    "description": {
      "defaultExecutablePath": "dist/StaticFilesHandler",
      "workingDirectory": "dist",
      "arguments": [ "--urls", "http://127.0.0.1:%FUNCTIONS_CUSTOMHANDLER_PORT%" ]
    },
    "enableForwardingHttpRequest": true
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    }
  }
}
